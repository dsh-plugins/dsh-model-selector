{
  "name": "@dsh-plugin/dsh-model-selector",
  "version": "0.1.0",
  "description": "为 DeepSeek Harness 的输入框模型选择器提供四种样式。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugins/dsh-model-selector.git"
  },
  "homepage": "https://github.com/dsh-plugins/dsh-model-selector",
  "bugs": "https://github.com/dsh-plugins/dsh-model-selector/issues",
  "keywords": ["dsh-plugin", "deepseek-harness", "model-selector", "agent-teams"],
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["lib", "cordis.patch.yml", "locale", "icon.svg", "README.zh_CN.md", "docs/gugle-layout.png"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@dsh-plugin/dsh-loader"]
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.host.json --noEmit",
    "build": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.types.json && tsdown --config tsdown.client.config.mjs",
    "test": "node --test tests/*.test.ts"
  },
  "peerDependencies": {
    "@dsh-plugin/dsh-loader": "^2.0.0-dev.45160670240"
  },
  "devDependencies": {
    "@dsh-plugin/dsh-loader": "2.0.0-dev.45160670240",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.89.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
